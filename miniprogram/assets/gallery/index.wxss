/**pages/photo-gallery/index.wxss**/

.container {
  background: #FFF8F0;
  min-height: 100vh;
}

/* ===== 分类筛选 ===== */
.category-bar {
  display: flex;
  white-space: nowrap;
  padding: 20rpx 28rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.category-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  background: #F5F5F5;
  transition: all 0.2s;
}

.category-item.active {
  background: #CC0000;
  color: #FFFFFF;
  font-weight: 500;
}

/* ===== 照片网格 ===== */
.photo-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 20rpx 28rpx;
}

.photo-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.photo-item:active {
  transform: scale(0.97);
}

.photo-image {
  position: relative;
  height: 240rpx;
  overflow: hidden;
}

.photo-real-image {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #E8E0D8, #F0E8E0);
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-emoji {
  font-size: 64rpx;
}

.photo-category-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
}

.photo-info {
  padding: 16rpx 18rpx 20rpx;
}

.photo-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.photo-desc {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 6rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.photo-date {
  font-size: 20rpx;
  color: #BBB;
}

/* ===== 大图预览 ===== */
.preview-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.95);
  z-index: 100;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.preview-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.preview-container {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 36rpx;
  padding-top: calc(24rpx + constant(safe-area-inset-top));
  padding-top: calc(24rpx + env(safe-area-inset-top));
}

.preview-count {
  font-size: 28rpx;
  color: #FFFFFF;
}

.preview-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FFFFFF;
}

.preview-swiper {
  flex: 1;
}

.preview-image-wrapper {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-image {
  width: 100%;
  height: 70vh;
}

.preview-info {
  padding: 24rpx 36rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.preview-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 6rpx;
}

.preview-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.4;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #AAA;
}
