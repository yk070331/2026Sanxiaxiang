<!--pages/photo-gallery/index.wxml - 实景相册页-->
<view class="container">
  <view class="gallery-intro">
    <text class="gallery-heading">用影像认识井冈山与乔林</text>
    <text class="gallery-note">已收录 {{availableCount}} 张。开放图片来自井冈山区域，地点与拍摄来源均单独标注。</text>
    <button wx:if="{{pendingCount}}" class="pending-toggle" bindtap="onTogglePending">{{showPending ? '收起待采集项' : '查看待采集清单'}}（{{pendingCount}}项）</button>
  </view>
  <!-- 分类筛选 -->
  <scroll-view class="category-bar" scroll-x="true" enable-flex>
    <view
      class="category-item {{currentCategory === item.id ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="id"
      wx:for-item="item"
      data-id="{{item.id}}"
      bindtap="onCategoryChange"
    >
      <text>{{item.name}}</text>
    </view>
  </scroll-view>

  <!-- 照片瀑布流/网格 -->
  <view class="photo-grid">
    <view
      class="photo-item"
      wx:for="{{photos}}"
      wx:key="id"
      wx:for-item="photo"
      data-src="{{photo.src}}"
      data-index="{{index}}"
      bindtap="onPhotoTap"
    >
      <view class="photo-image">
        <image
          wx:if="{{photo.available}}"
          class="photo-real-image"
          src="{{photo.src}}"
          mode="aspectFill"
          lazy-load="true"
        ></image>
        <view wx:else class="photo-placeholder">
          <text class="photo-emoji">{{photo.category === 'revolutionary' ? '🏛️' : (photo.category === 'heritage' ? '📜' : (photo.category === 'village' ? '🏘️' : '🌿'))}}</text>
        </view>
        <view class="photo-category-tag">
          <text class="tag tag-red" wx:if="{{photo.category === 'revolutionary'}}">{{photo.categoryName}}</text>
          <text class="tag tag-purple" wx:elif="{{photo.category === 'heritage'}}">{{photo.categoryName}}</text>
          <text class="tag tag-gold" wx:elif="{{photo.category === 'village'}}">{{photo.categoryName}}</text>
          <text class="tag tag-green" wx:else>{{photo.categoryName}}</text>
        </view>
      </view>
      <view class="photo-info">
        <text class="photo-title">{{photo.title}}</text>
        <text class="photo-desc">{{photo.desc}}</text>
        <text class="photo-date">{{photo.date}}</text>
        <text class="photo-scope" wx:if="{{photo.scopeLabel}}">{{photo.scopeLabel}}</text>
        <text class="photo-credit" wx:if="{{photo.license}}">{{photo.creator}} · {{photo.license}}</text>
        <text class="photo-credit" wx:elif="{{photo.sourceLabel}}">{{photo.sourceLabel}}</text>
        <text class="photo-credit" wx:elif="{{!photo.available}}">待采集实景照片</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{photos.length === 0}}">
    <text class="empty-icon">📷</text>
    <text class="empty-text">实景照片采集中，敬请期待</text>
  </view>

  <!-- 大图预览弹窗 -->
  <view class="preview-mask {{showPreview ? 'show' : ''}}" bindtap="onClosePreview">
    <view class="preview-container" catchtap="onStopPropagation">
      <view class="preview-header">
        <text class="preview-count">{{previewIndex + 1}} / {{previewPhotos.length}}</text>
        <view class="preview-close" bindtap="onClosePreview">
          <text>✕</text>
        </view>
      </view>
      <swiper
        class="preview-swiper"
        current="{{previewIndex}}"
        bindchange="onPreviewChange"
        indicator-dots="{{false}}"
      >
        <swiper-item wx:for="{{previewPhotos}}" wx:key="*this" wx:for-item="src">
          <view class="preview-image-wrapper">
            <image class="preview-image" src="{{src}}" mode="aspectFit"></image>
          </view>
        </swiper-item>
      </swiper>
      <scroll-view scroll-y class="preview-info" wx:if="{{previewItems[previewIndex]}}">
        <text class="preview-title">{{previewItems[previewIndex].title}}</text>
        <text class="preview-desc">{{previewItems[previewIndex].desc}}</text>
        <view class="preview-credit" wx:if="{{previewItems[previewIndex].license}}">
          <text>摄影：{{previewItems[previewIndex].creator}} · {{previewItems[previewIndex].license}}</text>
          <text>{{previewItems[previewIndex].changes}}</text>
          <text>图片按原许可提供，改编图须遵守相同许可。</text>
          <text selectable="true">来源：{{previewItems[previewIndex].sourceUrl}}</text>
          <text selectable="true">许可：{{previewItems[previewIndex].licenseUrl}}</text>
          <view class="credit-actions">
            <button data-field="sourceUrl" bindtap="onCopyCredit">复制图片来源</button>
            <button data-field="licenseUrl" bindtap="onCopyCredit">复制许可链接</button>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="safe-area-bottom"></view>
</view>
