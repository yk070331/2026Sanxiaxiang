/**app.wxss**/

/* 全局样式变量 */
page {
  --red-primary: #CC0000;
  --red-dark: #8B0000;
  --red-light: #FF4444;
  --gold: #D4A017;
  --gold-light: #F0D060;
  --bg-cream: #FFF8F0;
  --text-primary: #1A1A1A;
  --text-secondary: #666666;
  --text-light: #999999;
  --white: #FFFFFF;
  --border: #E8E8E8;
  --shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.08);

  background: var(--bg-cream);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 按钮重置 */
button {
  background: initial;
  padding: 0;
  line-height: inherit;
  font-size: inherit;
}

button:focus { outline: 0; }
button::after { border: none; }

/* 通用按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #CC0000, #E83030);
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 20rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(204, 0, 0, 0.3);
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-gold {
  background: linear-gradient(135deg, #D4A017, #E8C040);
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 20rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(212, 160, 23, 0.3);
}

.btn-outline {
  background: transparent;
  color: #CC0000;
  border: 2rpx solid #CC0000;
  border-radius: 16rpx;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  text-align: center;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 20rpx 28rpx;
  box-shadow: var(--shadow);
}

/* 通用标题 */
.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  position: relative;
  padding-left: 24rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #CC0000, #FF4444);
  border-radius: 3rpx;
}

/* 红色装饰线 */
.red-divider {
  width: 100%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #CC0000, transparent);
  margin: 20rpx 0;
}

/* 通用标签 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 10rpx;
}

.tag-red {
  background: #FFF0F0;
  color: #CC0000;
}

.tag-gold {
  background: #FFF8E8;
  color: #B8860B;
}

.tag-green {
  background: #F0FFF0;
  color: #228B22;
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 关怀模式：关键页面在根节点增加 care-mode 类即可启用 */
.care-mode {
  font-size: 34rpx;
}

.care-mode text {
  line-height: 1.8;
}

.care-mode button {
  min-height: 92rpx;
  font-size: 34rpx !important;
}

.network-banner {
  background: #FFF3CD;
  color: #7A5500;
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  text-align: center;
}

.care-toggle {
  background: rgba(255, 255, 255, 0.94);
  color: #8B0000;
  border-radius: 28rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
}
