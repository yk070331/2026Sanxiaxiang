.page { min-height: 100vh; background: #F5F1EA; padding-bottom: 32rpx; color: #25211D; }
.hero { padding: 58rpx 36rpx 48rpx; background: linear-gradient(145deg, #6F0000, #B01919); color: #FFFFFF; }
.hero-kicker { display: block; font-size: 20rpx; letter-spacing: 5rpx; opacity: 0.72; margin-bottom: 16rpx; }
.hero-title { display: block; font-size: 42rpx; font-weight: 700; line-height: 1.35; }
.hero-desc { display: block; margin-top: 18rpx; font-size: 25rpx; line-height: 1.75; color: rgba(255, 255, 255, 0.84); }
.status-card, .section-card { margin: 24rpx 28rpx 0; padding: 28rpx; border-radius: 22rpx; background: #FFFFFF; box-shadow: 0 6rpx 24rpx rgba(70, 45, 20, 0.06); }
.status-card { margin-top: -22rpx; position: relative; }
.status-heading { display: flex; justify-content: space-between; align-items: baseline; }
.section-title { font-size: 31rpx; font-weight: 700; color: #2D241D; }
.refresh-time { font-size: 20rpx; color: #999; }
.status-grid { display: flex; margin: 24rpx 0; border: 1rpx solid #EEE5DC; border-radius: 16rpx; overflow: hidden; }
.status-item { flex: 1; padding: 22rpx 8rpx; text-align: center; border-right: 1rpx solid #EEE5DC; }
.status-item:last-child { border-right: 0; }
.status-value { display: block; color: #8B0000; font-size: 28rpx; font-weight: 700; }
.status-value.ok { color: #247747; }
.status-value.muted { color: #806F62; }
.status-label { display: block; margin-top: 7rpx; color: #7D736B; font-size: 21rpx; }
.data-list { margin: 22rpx 0; }
.data-row { display: flex; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #F0ECE7; color: #5E554E; font-size: 25rpx; }
.data-row text:last-child { color: #8B0000; font-weight: 600; }
.policy-item { display: flex; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid #F0ECE7; }
.policy-item:last-child { border-bottom: 0; }
.policy-index { color: #B99143; font-size: 22rpx; font-weight: 700; letter-spacing: 1rpx; }
.policy-copy { flex: 1; }
.policy-title { display: block; font-size: 27rpx; font-weight: 650; margin-bottom: 8rpx; }
.policy-text, .body-text { display: block; color: #695F57; font-size: 24rpx; line-height: 1.75; }
.primary-button, .secondary-button, .danger-button { border-radius: 44rpx; font-size: 26rpx; font-weight: 600; }
.primary-button { margin-top: 24rpx; color: #FFFFFF; background: #9E1010; }
.secondary-button { color: #8B0000; background: #FFF3F1; border: 1rpx solid #E6BCB6; }
.danger-button { margin-top: 8rpx; color: #A32720; background: #FFFFFF; border: 1rpx solid #DAAAA5; }
.primary-button::after, .secondary-button::after, .danger-button::after { border: 0; }
.helper-text { display: block; text-align: center; color: #93877D; font-size: 20rpx; line-height: 1.6; margin-top: 12rpx; }
.footer-note { display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 34rpx 24rpx 8rpx; color: #958A80; font-size: 20rpx; }
