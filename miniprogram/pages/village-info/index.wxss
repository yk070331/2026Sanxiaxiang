/**pages/village-info/index.wxss**/

.container {
  background: #FFF8F0;
  min-height: 100vh;
}

/* ===== 头部 ===== */
.info-hero {
  background: linear-gradient(160deg, #8B0000, #CC0000);
  padding: 48rpx 36rpx 40rpx;
}

.info-village-name {
  font-size: 42rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 8rpx;
}

.info-village-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ===== 分类 Tab ===== */
.section-tabs {
  display: flex;
  white-space: nowrap;
  padding: 20rpx 28rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.section-tab {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  background: #F5F5F5;
  transition: all 0.2s;
}

.section-tab.active {
  background: #CC0000;
  color: #FFFFFF;
}

.section-tab-icon {
  font-size: 28rpx;
}

.section-tab-name {
  white-space: nowrap;
}

/* ===== 内容区 ===== */
.info-content {
  padding: 20rpx 28rpx;
}

.info-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.info-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #F5F0EB;
}

.label-dot {
  width: 8rpx;
  height: 28rpx;
  background: #CC0000;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.info-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

/* ===== 键值对表格 ===== */
.info-table {
  display: flex;
  flex-direction: column;
}

.info-row {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F5F0EB;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row-label {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #999;
  font-weight: 500;
}

.info-row-value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #AAA;
}
