/**pages/red-stories/index.wxss**/
.container { background: #FFF8F0; min-height: 100vh; }

.category-bar {
  display: flex;
  white-space: nowrap;
  padding: 20rpx 28rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.category-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  background: #F5F5F5;
  transition: all 0.2s;
}

.category-item.active { background: #CC0000; color: #FFFFFF; font-weight: 500; }
.stories-list { padding: 20rpx 28rpx; }

.story-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.story-card:active { transform: scale(0.98); }
.story-card-image { position: relative; height: 200rpx; overflow: hidden; }

.story-card-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #8B0000, #CC0000);
  display: flex;
  align-items: center;
  justify-content: center;
}

.story-card-emoji { font-size: 72rpx; }
.story-card-category { position: absolute; top: 16rpx; left: 16rpx; }
.story-card-body { padding: 20rpx 24rpx 24rpx; }

.story-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 8rpx;
}

.story-card-excerpt {
  font-size: 26rpx;
  color: #888;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 14rpx;
}

.story-card-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 16rpx; }
.meta-author, .meta-date, .meta-audio { font-size: 22rpx; color: #AAA; }
.meta-audio { color: #CC0000; }

.verification-badge {
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
}

.verification-badge.verified { color: #176B3A; background: #E8F6ED; }
.verification-badge.pending { color: #8A5A00; background: #FFF3D6; }
.story-detail { padding-bottom: 40rpx; }
.detail-hero { position: relative; min-height: 260rpx; display: flex; align-items: flex-end; }

.detail-hero-placeholder {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, #4A0000, #8B0000);
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-hero-emoji { font-size: 80rpx; }
.detail-hero-info { position: relative; z-index: 1; padding: 36rpx; }
.detail-title { display: block; font-size: 36rpx; font-weight: 700; color: #FFFFFF; margin-bottom: 10rpx; }
.detail-meta { display: flex; align-items: center; gap: 12rpx; }
.meta-tag { border: 1rpx solid rgba(255, 255, 255, 0.4); color: #FFFFFF !important; background: rgba(255, 255, 255, 0.2) !important; }
.meta-text { font-size: 22rpx; color: rgba(255, 255, 255, 0.7); }

.audio-player {
  background: linear-gradient(135deg, #FFF5F5, #FFF0F0);
  margin: 20rpx 28rpx;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #F0D0D0;
}

.audio-header { display: flex; justify-content: space-between; gap: 16rpx; margin-bottom: 16rpx; }
.audio-label { font-size: 26rpx; font-weight: 600; color: #CC0000; }
.audio-source { font-size: 22rpx; color: #777; text-align: right; }
.audio-controls { display: flex; align-items: center; gap: 16rpx; }

.audio-btn-play {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #CC0000;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(204, 0, 0, 0.3);
}

.play-icon { font-size: 32rpx; }
.audio-progress-area { flex: 1; display: flex; flex-direction: column; }
.audio-slider { width: 100%; margin: 0; }
.audio-time { display: flex; justify-content: flex-end; gap: 4rpx; font-size: 20rpx; color: #777; margin-top: -4rpx; }

.verification-panel {
  margin: 20rpx 28rpx;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  border-left: 8rpx solid #D29A24;
  background: #FFF7E6;
}

.verification-panel.verified { border-left-color: #2C8A51; background: #EEF8F1; }
.verification-title, .verification-note { display: block; }
.verification-title { color: #4A3211; font-size: 26rpx; font-weight: 600; margin-bottom: 8rpx; }
.verification-note { color: #715D3D; font-size: 24rpx; line-height: 1.7; }

.detail-content { background: #FFFFFF; margin: 20rpx 28rpx; border-radius: 20rpx; padding: 28rpx; }
.content-header { display: flex; align-items: center; margin-bottom: 16rpx; }
.label-dot { width: 8rpx; height: 28rpx; background: #CC0000; border-radius: 4rpx; margin-right: 12rpx; }
.content-title { font-size: 30rpx; font-weight: 600; color: #1A1A1A; }
.content-body { font-size: 28rpx; color: #444; line-height: 2; text-indent: 2em; white-space: pre-wrap; }

.detail-source { background: #FAFAFA; margin: 0 28rpx; border-radius: 16rpx; padding: 24rpx; }
.source-label { font-size: 24rpx; font-weight: 600; color: #666; display: block; margin-bottom: 10rpx; }
.source-text { font-size: 24rpx; color: #777; display: block; line-height: 1.8; }
.detail-close { text-align: center; padding: 28rpx; }
.detail-close .btn-outline { display: inline-block; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-icon { font-size: 80rpx; opacity: 0.4; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #777; }

.reading-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 28rpx; gap: 16rpx; }
.reading-heading { font-size: 32rpx; font-weight: 600; }
.care-toggle { margin: 0; font-size: 26rpx; color: #8B0000; background: #FFF; }
.reading-tabs, .playback-rates { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin: 16rpx 0; }
.reading-tab, .rate-button { margin: 0; padding: 0 20rpx; font-size: 26rpx; background: #FFF; color: #7A2525; }
.reading-tab.selected, .rate-button.selected { background: #A30B14; color: #FFF; }
.playback-rates > text, .reading-note { font-size: 24rpx; color: #66564D; }
.reading-note { display: block; line-height: 1.7; margin: 12rpx 0; }
.audio-btn-play { padding: 0; margin: 0; }
.audio-btn-play::after { border: none; }
.audio-progress-area { min-width: 0; }
.audio-header, .detail-meta { flex-wrap: wrap; }
.audio-source { text-align: left; }
.care-mode .content-body { font-size: 36rpx; line-height: 2; }
.care-mode .story-card-title, .care-mode .detail-title { font-size: 40rpx; }
.care-mode .story-card-excerpt { display: block; font-size: 32rpx; -webkit-line-clamp: unset; }
.care-mode .meta-author, .care-mode .meta-date, .care-mode .meta-audio,
.care-mode .meta-text, .care-mode .meta-tag, .care-mode .source-text,
.care-mode .source-label, .care-mode .verification-note, .care-mode .verification-badge,
.care-mode .audio-source, .care-mode .audio-time, .care-mode .reading-note,
.care-mode .playback-rates > text { font-size: 30rpx; line-height: 1.8; }
.care-mode .verification-title, .care-mode .content-title, .care-mode .audio-label { font-size: 34rpx; }
.care-mode .care-toggle, .care-mode .category-item, .care-mode .reading-tab,
.care-mode .rate-button, .care-mode .btn-outline { font-size: 32rpx; min-height: 88rpx; }
.care-mode .category-item { box-sizing: border-box; padding: 20rpx 28rpx; }
.care-mode .audio-btn-play { width: 96rpx; height: 96rpx; }
.care-mode .play-icon { font-size: 42rpx; }
