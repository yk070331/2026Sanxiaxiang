<!--pages/red-stories/index.wxml - 红色故事页-->
<view class="container">
  <scroll-view class="category-bar" scroll-x="true" enable-flex>
    <view
      class="category-item {{currentCategory === item.id ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="id"
      wx:for-item="item"
      data-id="{{item.id}}"
      bindtap="onCategoryChange"
    >
      <text>{{item.name}}</text>
    </view>
  </scroll-view>

  <block wx:if="{{!currentStory}}">
    <view class="stories-list">
      <view
        class="story-card"
        wx:for="{{stories}}"
        wx:key="id"
        wx:for-item="story"
        wx:if="{{currentCategory === 'all' || story.category === currentCategory}}"
        data-id="{{story.id}}"
        bindtap="onStoryTap"
      >
        <view class="story-card-image">
          <view class="story-card-placeholder">
            <text class="story-card-emoji">📖</text>
          </view>
          <view class="story-card-category">
            <text class="tag tag-red" wx:if="{{story.category === '革命往事'}}">{{story.category}}</text>
            <text class="tag tag-gold" wx:else>{{story.category}}</text>
          </view>
        </view>
        <view class="story-card-body">
          <text class="story-card-title">{{story.title}}</text>
          <text class="story-card-excerpt">{{story.text.substring(0, 80)}}...</text>
          <view class="story-card-meta">
            <text class="verification-badge {{story.verificationClass}}">{{story.verificationStatus}}</text>
            <text class="meta-author">🗣️ {{story.author}}</text>
            <text class="meta-date">📅 {{story.date}}</text>
            <text class="meta-audio" wx:if="{{story.audioAvailable}}">🔊 {{story.audioDuration}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{stories.length === 0}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无故事，实地采集内容整理中</text>
    </view>
  </block>

  <block wx:if="{{currentStory}}">
    <view class="story-detail">
      <view class="detail-hero">
        <view class="detail-hero-placeholder">
          <text class="detail-hero-emoji">📜</text>
        </view>
        <view class="detail-hero-info">
          <text class="detail-title">{{currentStory.title}}</text>
          <view class="detail-meta">
            <text class="meta-tag tag-red">{{currentStory.category}}</text>
            <text class="meta-text">{{currentStory.date}}</text>
          </view>
        </view>
      </view>

      <view class="audio-player" wx:if="{{currentStory.audio && currentStory.audioAvailable}}">
        <view class="audio-header">
          <text class="audio-label">🎙️ 村民口述原声音频</text>
          <text class="audio-source">口述人：{{currentStory.author}}</text>
        </view>
        <view class="audio-controls">
          <view class="audio-btn-play" bindtap="onToggleAudio">
            <text class="play-icon">{{isPlaying && playingStoryId === currentStory.id ? '⏸️' : '▶️'}}</text>
          </view>
          <view class="audio-progress-area">
            <slider
              class="audio-slider"
              value="{{audioProgress}}"
              min="0"
              max="100"
              step="1"
              activeColor="#CC0000"
              backgroundColor="#E8E8E8"
              block-size="18"
              bindchange="onAudioSeek"
            />
            <view class="audio-time">
              <text>{{isPlaying && playingStoryId === currentStory.id ? audioCurrentTime : '00:00'}}</text>
              <text>/</text>
              <text>{{currentStory.audioDuration || '00:00'}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="audio-player" wx:elif="{{currentStory.audio}}">
        <view class="audio-header">
          <text class="audio-label">🎙️ 口述音频待上传</text>
          <text class="audio-source">上传并审核原始录音后即可启用</text>
        </view>
      </view>

      <view class="verification-panel {{currentStory.verificationClass}}">
        <text class="verification-title">史料状态：{{currentStory.verificationStatus}}</text>
        <text class="verification-note">{{currentStory.verificationNote}}</text>
      </view>

      <view class="detail-content">
        <view class="content-header">
          <view class="label-dot"></view>
          <text class="content-title">故事正文</text>
        </view>
        <text class="content-body">{{currentStory.text}}</text>
      </view>

      <view class="detail-source">
        <text class="source-label">来源与审核信息</text>
        <text class="source-text">当前署名：{{currentStory.author}}</text>
        <text class="source-text">记录日期：{{currentStory.date}}</text>
        <text class="source-text">关联地点：{{currentStory.relatedSite || '乔林村'}}</text>
      </view>

      <view class="detail-close">
        <button class="btn-outline" bindtap="onCloseStory">← 返回故事列表</button>
      </view>
    </view>
    <view class="safe-area-bottom"></view>
  </block>
</view>
