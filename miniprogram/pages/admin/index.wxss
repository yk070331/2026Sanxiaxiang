.container {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  background: #fff8f0;
}

.admin-hero {
  padding: 38rpx 32rpx;
  border-radius: 22rpx;
  color: #fff;
  background: linear-gradient(135deg, #8b0000, #cc0000);
  box-shadow: 0 10rpx 28rpx rgba(139, 0, 0, 0.2);
}

.hero-title,
.hero-desc,
.panel-title,
.queue-title,
.queue-desc,
.queue-source {
  display: block;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hero-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  opacity: 0.9;
}

.warning-card,
.message {
  margin-top: 22rpx;
  padding: 22rpx 26rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.warning-card {
  color: #8a4b00;
  background: #fff1d6;
}

.message {
  color: #1b5e20;
  background: #e8f5e9;
}

.panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.06);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.panel-title {
  margin-bottom: 22rpx;
  color: #333;
  font-size: 30rpx;
  font-weight: 700;
}

.picker-field,
.form-field {
  width: 100%;
  margin-bottom: 18rpx;
  padding: 22rpx;
  box-sizing: border-box;
  border: 1rpx solid #eadfd8;
  border-radius: 12rpx;
  color: #333;
  background: #fffdfb;
  font-size: 26rpx;
}

.form-textarea {
  min-height: 180rpx;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.action-row button {
  width: 100%;
  margin: 0;
  font-size: 25rpx;
}

.btn-secondary,
.btn-reject {
  color: #8b0000;
  border: 1rpx solid #cc0000;
  background: #fff;
}

.btn-primary,
.btn-approve {
  color: #fff;
  background: #cc0000;
}

.refresh-btn {
  width: auto;
  margin: 0 0 22rpx;
  padding: 0 24rpx;
  color: #8b0000;
  background: #fff0f0;
  font-size: 23rpx;
}

.queue-card {
  padding: 24rpx 0;
  border-top: 1rpx solid #f0e8e2;
}

.queue-title {
  color: #333;
  font-size: 28rpx;
  font-weight: 600;
}

.queue-desc,
.queue-source {
  margin: 10rpx 0;
  color: #777;
  font-size: 24rpx;
  line-height: 1.6;
}

