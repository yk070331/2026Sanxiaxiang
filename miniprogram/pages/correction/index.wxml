<view class="correction-page">
  <view class="hero-card">
    <text class="hero-kicker">共同守护真实史料</text>
    <text class="hero-title">我要纠错</text>
    <text class="hero-desc">发现位置、史实或图片信息有误时，请提交线索。内容经村级与实践团队审核后才会更新。</text>
  </view>

  <view class="form-card" wx:if="{{!completed}}">
    <view class="target-card">
      <text class="field-label">纠错对象</text>
      <text class="target-name">{{targetName}}</text>
      <text class="target-id">编号：{{targetId}}</text>
    </view>

    <view class="field-block">
      <text class="field-label">错误类型</text>
      <picker range="{{errorTypes}}" value="{{errorTypeIndex}}" bindchange="onTypeChange">
        <view class="picker-value">{{errorTypes[errorTypeIndex]}} <text>⌄</text></view>
      </picker>
    </view>

    <view class="field-block">
      <view class="field-heading">
        <text class="field-label">详细说明</text>
        <text class="counter">{{description.length}}/1000</text>
      </view>
      <textarea
        class="description-input"
        value="{{description}}"
        maxlength="1000"
        placeholder="请说明哪里有误，并尽量写明正确内容、资料来源或现场依据（至少5个字）"
        bindinput="onDescriptionInput"
      ></textarea>
    </view>

    <view class="privacy-note">
      <text class="note-title">提交说明</text>
      <text class="note-text">当前版本不收集姓名和手机号；系统仅使用微信云端身份防止重复滥用。请勿填写无关个人隐私。</text>
    </view>

    <button class="submit-button" loading="{{submitting}}" bindtap="onSubmit">
      {{submitting ? '正在提交…' : '提交纠错线索'}}
    </button>
  </view>

  <view class="result-card" wx:else>
    <text class="result-icon">{{queued ? '📮' : '✅'}}</text>
    <text class="result-title">{{queued ? '已保存，等待联网补传' : '纠错线索已提交'}}</text>
    <text class="result-desc">
      {{queued ? '当前云环境未配置或网络不可用，线索已安全保存在本机，恢复后会自动补传。' : '感谢你的认真核对。管理员审核后才会修改公开内容。'}}
    </text>
    <button class="back-button" bindtap="onBack">返回详情</button>
  </view>
</view>
