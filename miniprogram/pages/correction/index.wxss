.correction-page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  background: #FFF8F0;
}

.hero-card {
  padding: 38rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #790000, #C51B1B);
  box-shadow: 0 12rpx 30rpx rgba(105, 0, 0, 0.2);
  color: #FFFFFF;
}

.hero-kicker,
.hero-title,
.hero-desc,
.field-label,
.target-name,
.target-id,
.note-title,
.note-text,
.result-icon,
.result-title,
.result-desc {
  display: block;
}

.hero-kicker {
  color: #F3D194;
  font-size: 22rpx;
  letter-spacing: 3rpx;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 800;
}

.hero-desc {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 25rpx;
  line-height: 1.7;
}

.form-card,
.result-card {
  margin-top: 22rpx;
  padding: 30rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 24rpx rgba(71, 41, 24, 0.08);
}

.target-card {
  padding: 22rpx;
  border-left: 8rpx solid #C51B1B;
  border-radius: 12rpx;
  background: #FFF4F1;
}

.field-label {
  color: #6B5D56;
  font-size: 24rpx;
  font-weight: 600;
}

.target-name {
  margin-top: 8rpx;
  color: #291E19;
  font-size: 31rpx;
  font-weight: 700;
}

.target-id {
  margin-top: 4rpx;
  color: #A08E85;
  font-size: 21rpx;
}

.field-block {
  margin-top: 28rpx;
}

.field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.counter {
  color: #A79A94;
  font-size: 21rpx;
}

.picker-value,
.description-input {
  margin-top: 12rpx;
  border: 2rpx solid #E7DDD7;
  border-radius: 14rpx;
  background: #FFFEFD;
  color: #332A26;
  font-size: 27rpx;
  box-sizing: border-box;
}

.picker-value {
  display: flex;
  justify-content: space-between;
  padding: 22rpx;
}

.description-input {
  width: 100%;
  height: 260rpx;
  padding: 22rpx;
  line-height: 1.65;
}

.privacy-note {
  margin-top: 26rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #FFF8E8;
}

.note-title {
  color: #7A5B22;
  font-size: 24rpx;
  font-weight: 700;
}

.note-text {
  margin-top: 8rpx;
  color: #846F48;
  font-size: 22rpx;
  line-height: 1.7;
}

.submit-button,
.back-button {
  margin-top: 28rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.submit-button {
  background: linear-gradient(135deg, #A80000, #D62D2D);
  color: #FFFFFF;
}

.result-card {
  padding-top: 58rpx;
  padding-bottom: 48rpx;
  text-align: center;
}

.result-icon {
  font-size: 82rpx;
}

.result-title {
  margin-top: 18rpx;
  color: #382821;
  font-size: 34rpx;
  font-weight: 700;
}

.result-desc {
  margin-top: 16rpx;
  color: #76665E;
  font-size: 25rpx;
  line-height: 1.8;
}

.back-button {
  background: #FFF7EF;
  color: #8B0000;
  border: 2rpx solid #D9B8A9;
}
